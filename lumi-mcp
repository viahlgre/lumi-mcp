SERVER_VERSION = "0.1.0"
PROTOCOL_FALLBACK = "2024-11-05"
PROTOCOL_KNOWN = {
    "2024-11-05",
    "2025-03-26",
    "2025-06-18",
}

DEFAULT_CONFIG = Path.home() / ".lumi-mcp" / "config.yaml"
STATE_DIR = Path(os.environ.get("LUMI_MCP_STATE", Path.home() / ".lumi-mcp"))

MAX_OUTPUT_BYTES = 64 * 1024
DEFAULT_TIMEOUT_S = 120
MAX_TIMEOUT_S = 900

# Job output goes here, inside the project directory so it survives and is
# readable with normal tools -- but mounted READ-ONLY into both the tool
# runner and the job's own container. Slurm opens --output on the compute node
# as the user and follows symlinks, so a writable log directory would let the
# agent point a job's stdout at any file it owns. Read-only closes that.
LOG_DIR_NAME = ".mcp-jobs"

DEFAULT_MAX_JOBS = 4
DEFAULT_MAX_NTASKS = 8
DEFAULT_MAX_WALLTIME_MINUTES = 60
DEFAULT_QUERY_CACHE_S = 5.0

SLURM_TIMEOUT_S = 60
LOG_TAIL_LINES = 100
MAX_LOG_TAIL_LINES = 500
MAX_LOG_BYTES = 32 * 1024

# Flags applied at `instance start`. These are the containment contract and
# they are part of the instance identity, so changing this list yields new
# instance names rather than silently reusing containers with old mounts.
#
# Verified against Apptainer 1.5.5:
#   - the instance NAME is a positional argument, not --name
#   - `--no-start` does not exist; PID 1 is Apptainer's own `appinit`, so an
#     image startscript may run briefly but nothing has to stay alive
#   - `--contain` alone already gives an empty, writable $HOME
#   - unknown `--no-mount` values are IGNORED with a warning, not rejected,
#     so the value has to be one that really exists: 'bind-paths' is the
#     name that disables the `bind path =` entries from apptainer.conf
#   - a bind destination must be absolute: `-B dir:~` fails, `-B dir:/path`
#     or `-H dir:/path` works, and -H also sets $HOME
#   - flags given to `exec` after the instance URI are treated as the
#     command, and mount flags before it are silently ignored, so exec
#     cannot add mounts to a running instance
BASE_START_FLAGS = ["--no-home", "--contain", "--cleanenv"]
OPTIONAL_START_FLAGS = ["--no-mount=bind-paths"]

# TODO(slurm): `sbatch` inside the image is defence in depth only. The real
# boundary is that /run/munge is not mounted, so nothing inside can sign a
# request to slurmctld. Assert both at startup (see probe_containment).


def log(msg: str) -> None:
    print(f"[lumi-mcp] {msg}", file=sys.stderr, flush=True)


class ConfigError(Exception):
    pass


class ToolError(Exception):
    """A failure that belongs to the tool call, not to the protocol."""


# --------------------------------------------------------------------------
# config
# --------------------------------------------------------------------------


@dataclass(frozen=True)
class Project:
    alias: str
    description: str
    directory: Path
    image: Path
    account: str
    partition: str
    home: Path
    env: dict[str, str] = field(default_factory=dict)


@dataclass(frozen=True)
class Config:
    path: Path
    command: str
    projects: list[Project]
    max_jobs: int = DEFAULT_MAX_JOBS
    max_ntasks: int = DEFAULT_MAX_NTASKS
    max_walltime_minutes: int = DEFAULT_MAX_WALLTIME_MINUTES
    query_cache_s: float = DEFAULT_QUERY_CACHE_S

    def by_alias(self, alias: str) -> Project:
        for p in self.projects:
            if p.alias == alias:
                return p
        known = ", ".join(p.alias for p in self.projects) or "<none>"
        raise ConfigError(f"no project named {alias!r} in {self.path} (known: {known})")


def _as_env(raw: Any, where: str) -> dict[str, str]:
    """Accept either a plain map or a list of one-key maps."""
    if raw is None:
        return {}
    if isinstance(raw, dict):
        return {str(k): str(v) for k, v in raw.items()}
    if isinstance(raw, list):
        out: dict[str, str] = {}
        for item in raw:
            if not isinstance(item, dict):
                raise ConfigError(f"{where}.env: expected a mapping, got {type(item).__name__}")
            for k, v in item.items():
                out[str(k)] = str(v)
        return out
    raise ConfigError(f"{where}.env: expected a mapping or a list of mappings")


def load_config(path: Path) -> Config:
    try:
        raw = yaml.safe_load(path.read_text())
    except FileNotFoundError:
        raise ConfigError(f"config not found: {path}") from None
    except yaml.YAMLError as exc:
        raise ConfigError(f"{path}: {exc}") from None

    if not isinstance(raw, dict):
        raise ConfigError(f"{path}: top level must be a mapping")

    general = raw.get("general") or {}
    if not isinstance(general, dict):
        raise ConfigError(f"{path}: 'general' must be a mapping")
    command = str(general.get("command") or "").strip()
    if not command:
        raise ConfigError(f"{path}: general.command is required (e.g. /usr/bin/apptainer)")

    def number(key: str, default: float, minimum: float, cast=float):
        raw_value = general.get(key)
        if raw_value is None:
            return default
        try:
            value = cast(raw_value)
        except (TypeError, ValueError):
            raise ConfigError(f"{path}: general.{key} must be a number") from None
        if value < minimum:
            raise ConfigError(f"{path}: general.{key} must be >= {minimum}")
        return value

    entries = raw.get("projects")
    if not isinstance(entries, list) or not entries:
        raise ConfigError(f"{path}: 'projects' must be a non-empty list")

    projects: list[Project] = []
    seen: set[str] = set()
    for idx, entry in enumerate(entries):
        where = f"projects[{idx}]"
        if not isinstance(entry, dict):
            raise ConfigError(f"{where}: must be a mapping")
        alias = str(entry.get("alias") or "").strip()
        if not alias:
            raise ConfigError(f"{where}: alias is required")
        if not all(c.isalnum() or c in "_.-" for c in alias):
            raise ConfigError(f"{where}: alias {alias!r} may only contain letters, digits, '_', '.', '-'")
        if alias in (".", ".."):
            # The alias names a directory under <project>/.mcp-jobs and a part
            # of the instance name; "." or ".." would escape both.
            raise ConfigError(f"{where}: alias {alias!r} is not a usable name")
        if alias in seen:
            raise ConfigError(f"{where}: duplicate alias {alias!r}")
        seen.add(alias)

        def need(key: str) -> str:
            val = entry.get(key)
            if val is None or str(val).strip() == "":
                raise ConfigError(f"{where} ({alias}): {key} is required")
            return str(val).strip()

        directory = Path(need("directory")).expanduser()
        image = Path(need("image")).expanduser()
        home = Path(need("home")).expanduser()
        for name, p in (("directory", directory), ("image", image), ("home", home)):
            if not p.is_absolute():
                raise ConfigError(f"{where} ({alias}): {name} must be an absolute path")
        # `home` is bound over the real $HOME inside the container. Pointing it
        # at the real home would put ssh keys and dotfiles back inside, which
        # defeats the point of the fake home.
        if Path(os.path.abspath(home)) == Path(os.path.abspath(host_home())):
            raise ConfigError(
                f"{where} ({alias}): home must not be the real $HOME ({host_home()}); "
                "give the container its own throwaway directory"
            )
        if Path(os.path.abspath(home)) == Path(os.path.abspath(directory)):
            raise ConfigError(f"{where} ({alias}): home and directory must differ")

        projects.append(
            Project(
                alias=alias,
                description=str(entry.get("description") or ""),
                directory=directory,
                image=image,
                account=need("account"),
                partition=need("partition"),
                home=home,
                env=_as_env(entry.get("env"), where),
            )
        )

    return Config(
        path=path,
        command=command,
        projects=projects,
        max_jobs=int(number("max_jobs", DEFAULT_MAX_JOBS, 1, int)),
        max_ntasks=int(number("max_ntasks", DEFAULT_MAX_NTASKS, 1, int)),
        max_walltime_minutes=int(
            number("max_walltime_minutes", DEFAULT_MAX_WALLTIME_MINUTES, 1, int)
        ),
        query_cache_s=number("query_cache_s", DEFAULT_QUERY_CACHE_S, 0.0),
    )


def path_is_under(child: Path, parent: Path) -> bool:
    try:
        child.relative_to(parent)
        return True
    except ValueError:
        return False


def host_home() -> Path:
    """The real home directory of the user running the server.

    A project's `home` is bound over this path inside the container, so the
    path stays the same but the contents are the throwaway one. Configuring a
    project whose `home` *is* the real home would put ssh keys and dotfiles
    back inside the container, and is refused at startup.
    """
    return Path.home()


def select_project(config: Config, alias: str | None, cwd: Path) -> Project:
    if alias:
        return config.by_alias(alias)

    # Running in situ: pick the project that contains the working directory.
    # Component-wise comparison, so /a/b never matches /a/bc.
    real_cwd = cwd.resolve()
    matches = [
        p for p in config.projects if path_is_under(real_cwd, p.directory.resolve())
    ]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        # deepest directory wins
        return max(matches, key=lambda p: len(p.directory.resolve().parts))

    if len(config.projects) == 1:
        return config.projects[0]

    aliases = ", ".join(p.alias for p in config.projects)
    raise ConfigError(
        f"cannot choose a project: {real_cwd} is not inside any configured project "
        f"and --project was not given (known: {aliases})"
    )


def job_log_root(project: Project) -> Path:
    """The whole job tree for a project. Bound read-only into every container."""
    return project.directory / LOG_DIR_NAME


def job_dir(project: Project) -> Path:
    """This alias's slice of it: logs and the scripts that produced them."""
    return job_log_root(project) / project.alias


def job_script_dir(project: Project) -> Path:
    return job_dir(project) / "scripts"


def ledger_path(project: Project) -> Path:
    return STATE_DIR / "projects" / project.alias / "jobs.jsonl"


def bind_specs(project: Project) -> list[str]:
    """The complete mount set for both the runner and the job's container.

    Order matters: the read-only log directory has to come after the
    read-write project directory it lives inside, otherwise the ro mount is
    hidden by the parent bind.
    """
    directory = str(project.directory)
    logs = str(job_log_root(project))
    return [
        f"{directory}:{directory}",
        # The whole tree, not just this alias's slice: with only <alias>/ read
        # -only, the parent would still be writable through the project bind
        # and a session could plant a symlink in a sibling alias's namespace.
        f"{logs}:{logs}:ro",
        f"{project.home}:{host_home()}",
    ]


