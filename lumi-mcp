def slurm(*argv: str, timeout: float = SLURM_TIMEOUT_S) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(
            list(argv),
            stdin=subprocess.DEVNULL,
            capture_output=True,
            timeout=timeout,
        )
    except FileNotFoundError:
        raise ToolError(f"{argv[0]} not found on PATH; is Slurm installed on this host?") from None
    except subprocess.SubprocessError as exc:
        raise ToolError(f"{argv[0]} failed: {exc}") from None


def available_partitions(configured: str) -> str:
    """Best-effort hint when sbatch refuses a partition."""
    try:
        proc = subprocess.run(
            ["sinfo", "-h", "-o", "%P"],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            timeout=15,
        )
    except (OSError, subprocess.SubprocessError):
        return f"could not run sinfo; config asks for partition {configured!r}"
    names = sorted({p.strip().rstrip("*") for p in proc.stdout.decode().split() if p.strip()})
    if not names:
        return "sinfo reported no partitions"
    hint = "partitions on this host: " + ", ".join(names)
    if configured not in names:
        hint += f"  (config asks for {configured!r})"
    return hint


# Slurm's pending reasons are terse and the agent should not have to learn
# them. Anything not listed falls through as the raw string.
PENDING_REASONS = {
    "Resources": "waiting for free CPUs/memory on a node",
    "Priority": "waiting behind higher-priority jobs",
    "PartitionNodeLimit": "this partition cannot give more nodes",
    "PartitionTimeLimit": "requested time exceeds the partition limit",
    "QOSMaxJobsPerUserLimit": "too many of your jobs are already queued",
    "QOSMaxCpuPerUserLimit": "too many of your CPUs are already in use",
    "AssocGrpCPUMinutesLimit": "the allocation's CPU-minutes are used up",
    "AssocGrpGRESMinutesLimit": "the allocation's GPU-minutes are used up",
    "ReqNodeNotAvail": "the node it wants is down or reserved",
    "JobHeldUser": "held by you (scontrol hold)",
    "JobHeldAdmin": "held by an administrator",
    "None": "queued",
}


def explain_pending(reason: str) -> str:
    if not reason:
        return "pending"
    hint = PENDING_REASONS.get(reason)
    return f"{reason} ({hint})" if hint else reason


def human_duration(seconds: float) -> str:
    seconds = max(0, int(seconds))
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}h{seconds % 3600 // 60:02d}m"
    return f"{seconds // 86400}d{seconds % 86400 // 3600:02d}h"


def time_limit(minutes: int) -> str:
    return f"{minutes // 60:02d}:{minutes % 60:02d}:00"


JOB_NAME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}")


def build_job_script(
    server: "Server",
    *,
    name: str,
    command: str,
    ntasks: int,
    minutes: int,
) -> str:
    """Render the batch script.

    Every agent-supplied value is a *value* in a line we own: the name is
    regex-validated, the numbers are ints, and the payload is quoted as a
    single argv element for sh -c inside the container. The agent never gets
    to write an #SBATCH line or the srun/container invocation itself.
    """
    project = server.project
    directory = str(project.directory)
    logs = str(job_log_root(project))

    container: list[str] = [
        server.runtime.command,
        "exec",
        *server.runtime.start_flags(),
        "--pwd",
        directory,
    ]
    for spec in bind_specs(project):
        container.extend(["-B", spec])
    container.extend([str(project.image), "/bin/sh", "-c", command])

    lines = [
        "#!/bin/bash",
        f"#SBATCH --job-name={name}",
        f"#SBATCH --partition={project.partition}",
        f"#SBATCH --account={project.account}",
        "#SBATCH --nodes=1",
        f"#SBATCH --ntasks={ntasks}",
        f"#SBATCH --time={time_limit(minutes)}",
        f"#SBATCH --chdir={directory}",
        f"#SBATCH --output={job_dir(project)}/%j.out",
        f"#SBATCH --error={job_dir(project)}/%j.out",
        f"#SBATCH --comment=lumi-mcp:{project.alias}",
        "set -euo pipefail",
        "umask 077",
        f"exec srun --ntasks={ntasks} {shlex.join(container)}",
        "",
    ]
    return "\n".join(lines)


class Ledger:
    """Append-only record of the jobs this server submitted.

    The agent chooses job names, so names cannot be an identity. Ownership is
    decided by this file, which lives outside every container.
    """

    def __init__(self, path: Path) -> None:
        self.path = path

    def append(self, record: dict[str, Any]) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        with self.path.open("a") as fh:
            fh.write(json.dumps(record) + "\n")
        os.chmod(self.path, 0o600)

    def entries(self, limit: int = 20) -> list[dict[str, Any]]:
        try:
            lines = self.path.read_text().splitlines()
        except FileNotFoundError:
            return []
        out: list[dict[str, Any]] = []
        for line in lines:
            try:
                out.append(json.loads(line))
            except ValueError:
                continue
        return out[-limit:]

    def has(self, job_id: int) -> dict[str, Any] | None:
        for record in self.entries(limit=10_000):
            if record.get("job_id") == job_id:
                return record
        return None


def job_state(job_id: int) -> dict[str, str]:
    """One id at a time: scontrol does not take a comma list."""
    proc = slurm("scontrol", "show", "job", str(job_id), "-o")
    text = (proc.stdout or b"").decode("utf-8", "replace").strip()
    if proc.returncode != 0 or not text:
        return {}
    return dict(
        token.split("=", 1) for token in text.split() if "=" in token
    )


def live_states(job_ids: list[int]) -> dict[int, dict[str, str]]:
    """Batch query for jobs the controller still knows about."""
    if not job_ids:
        return {}
    proc = slurm(
        "squeue",
        "-h",
        "-j",
        ",".join(str(j) for j in job_ids),
        "-o",
        "%A|%T|%N|%r|%M|%l",
    )
    out: dict[int, dict[str, str]] = {}
    for line in (proc.stdout or b"").decode("utf-8", "replace").splitlines():
        parts = line.split("|")
        if len(parts) != 6 or not parts[0].isdigit():
            continue
        job_id, state, nodes, reason, elapsed, limit = parts
        out[int(job_id)] = {
            "state": state,
            "nodes": nodes,
            "reason": reason,
            "elapsed": elapsed,
            "time_limit": limit,
        }
    return out

def migrate_legacy_ledger() -> None:
    """Split a pre-per-alias <state>/jobs.jsonl into per-alias ledgers.

    Without this, an upgrade silently orphans every job submitted before it:
    still running, no longer listed, no longer cancellable through the tools.
    Runs once and renames the old file so it cannot happen twice.
    """
    old = STATE_DIR / "jobs.jsonl"
    if not old.exists():
        return
    try:
        lines = old.read_text().splitlines()
    except OSError as exc:
        log(f"cannot read legacy ledger {old}: {exc}")
        return

    by_alias: dict[str, list[dict[str, Any]]] = {}
    for line in lines:
        try:
            record = json.loads(line)
        except ValueError:
            continue
        alias = record.get("alias")
        if isinstance(alias, str) and alias:
            by_alias.setdefault(alias, []).append(record)

    for alias, records in by_alias.items():
        target = STATE_DIR / "projects" / alias / "jobs.jsonl"
        target.parent.mkdir(parents=True, exist_ok=True)
        known: set[Any] = set()
        if target.exists():
            for line in target.read_text().splitlines():
                try:
                    known.add(json.loads(line).get("job_id"))
                except ValueError:
                    pass
        with target.open("a") as fh:
            for record in records:
                if record.get("job_id") in known:
                    continue
                fh.write(json.dumps(record) + "\n")
        os.chmod(target, 0o600)

    old.rename(old.with_name("jobs.jsonl.migrated"))
    log(f"migrated {old} into {len(by_alias)} per-alias ledger(s)")


@dataclass
class Server:
    config: Config
    project: Project
    runtime: Runtime
    instance: Instance
    ledger: Ledger
    jobs_cache: tuple[float, str] | None = None


def tool_shell(server: Server, args: dict[str, Any]) -> tuple[str, bool]:
    command = args.get("command")
    if not isinstance(command, str) or not command.strip():
        raise ToolError("command must be a non-empty string")

    cwd = resolve_cwd(server.project, args.get("cwd"))

    raw_timeout = args.get("timeout_s", DEFAULT_TIMEOUT_S)
    try:
        timeout_s = float(raw_timeout)
    except (TypeError, ValueError):
        raise ToolError("timeout_s must be a number") from None
    timeout_s = max(1.0, min(timeout_s, MAX_TIMEOUT_S))

    record, created = server.instance.ensure()
    script = build_script(server.project, cwd, command)
    rc, out, err, timed_out, duration = run_in_instance(
        server.runtime, server.instance.name, script, timeout_s
    )
    server.instance.touch()

    chunks = [f"exit_code: {rc}", f"duration_ms: {int(duration * 1000)}"]
    if created:
        chunks.append(f"instance: started {server.instance.name}")
    if timed_out:
        chunks.append(f"timed_out: true (after {timeout_s:g}s)")
    if out:
        chunks.append("--- stdout ---\n" + truncate(out).rstrip("\n"))
    if err:
        chunks.append("--- stderr ---\n" + truncate(err).rstrip("\n"))
    text = "\n".join(chunks)

    if timed_out:
        return text + (
            "\n\nNOTE: the timeout killed the host-side apptainer client. "
            "Processes started inside the container may still be running."
        ), True
    return text, rc != 0


