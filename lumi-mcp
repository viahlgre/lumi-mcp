def _int_arg(args: dict[str, Any], key: str, default: int) -> int:
    raw = args.get(key, default)
    if isinstance(raw, bool) or not isinstance(raw, (int, float, str)):
        raise ToolError(f"{key} must be an integer")
    try:
        return int(raw)
    except (TypeError, ValueError):
        raise ToolError(f"{key} must be an integer") from None


def tool_slurm_submit(server: Server, args: dict[str, Any]) -> tuple[str, bool]:
    command = args.get("command")
    if not isinstance(command, str) or not command.strip():
        raise ToolError("command must be a non-empty string")

    name = str(args.get("name") or "").strip()
    if not JOB_NAME_RE.fullmatch(name):
        raise ToolError(
            "name must be 1-64 characters of letters, digits, '_', '.', '-' "
            "and must start with a letter or digit"
        )

    ntasks = _int_arg(args, "ntasks", 1)
    if not 1 <= ntasks <= server.config.max_ntasks:
        raise ToolError(f"ntasks must be between 1 and {server.config.max_ntasks}")

    minutes = _int_arg(args, "time_minutes", 10)
    if not 1 <= minutes <= server.config.max_walltime_minutes:
        raise ToolError(
            f"time_minutes must be between 1 and {server.config.max_walltime_minutes}"
        )

    known = [r["job_id"] for r in server.ledger.entries(limit=10_000)]
    active = live_states(known[-50:])
    if len(active) >= server.config.max_jobs:
        raise ToolError(
            f"refusing to submit: {len(active)} job(s) already queued or running "
            f"(max_jobs={server.config.max_jobs}). Cancel one with slurm_cancel or wait."
        )

    script_text = build_job_script(
        server, name=name, command=command, ntasks=ntasks, minutes=minutes
    )

    # The script goes next to the job's log, inside the project tree that is
    # mounted read-only in the container: the agent can read what it
    # submitted but cannot touch it. The name is a placeholder until sbatch
    # hands back an id, because the id is not known before submitting.
    scripts_dir = job_script_dir(server.project)
    scripts_dir.mkdir(parents=True, exist_ok=True)
    staging = scripts_dir / f".pending-{os.urandom(6).hex()}.sh"
    fd = os.open(staging, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(script_text)

    # --export=NONE: sbatch would otherwise inherit this process's
    # environment, which is the harness's, tokens and all.
    proc = slurm("sbatch", "--parsable", "--export=NONE", str(staging))
    stdout = (proc.stdout or b"").decode("utf-8", "replace").strip()
    stderr = (proc.stderr or b"").decode("utf-8", "replace").strip()
    if proc.returncode != 0:
        hint = ""
        if "partition" in (stderr or stdout).lower():
            hint = "\n" + available_partitions(server.project.partition)
        raise ToolError(f"sbatch failed (exit {proc.returncode}): {stderr or stdout}{hint}")

    first = stdout.splitlines()[0] if stdout else ""
    job_id_text = first.split(";")[-1].strip()
    if not job_id_text.isdigit():
        raise ToolError(f"could not parse a job id from sbatch output: {stdout!r}")

    job_id = int(job_id_text)
    log_path = job_dir(server.project) / f"{job_id}.out"

    # sbatch has already copied the script into its own spool, so renaming it
    # afterwards is safe and makes <id>.sh sit beside <id>.out.
    script_path = scripts_dir / f"{job_id}.sh"
    try:
        os.replace(staging, script_path)
    except OSError as exc:
        log(f"could not rename {staging} to {script_path}: {exc}")
        script_path = staging
    record = {
        "job_id": job_id,
        "alias": server.project.alias,
        "name": name,
        "ntasks": ntasks,
        "time_limit": time_limit(minutes),
        "command": command[:4000],
        "submitted_at": time.time(),
        "script": str(script_path),
        "log": str(log_path),
        "account": server.project.account,
        "partition": server.project.partition,
    }
    server.ledger.append(record)
    server.jobs_cache = None

    text = "\n".join(
        [
            f"job_id: {job_id}",
            f"name: {name}",
            f"partition: {server.project.partition}  account: {server.project.account}",
            f"ntasks: {ntasks}  time_limit: {time_limit(minutes)}",
            f"log: {log_path}",
            f"script: {script_path}",
            "",
            "The job is queued. It runs unattended: poll with slurm_jobs and read "
            "output with slurm_logs. Cancelling is slurm_cancel.",
            "",
            "--- generated script ---",
            script_text.rstrip("\n"),
        ]
    )
    return text, False


def _job_rows(server: Server) -> list[dict[str, Any]]:
    entries = server.ledger.entries(limit=20)
    ids = [e["job_id"] for e in entries]
    live = live_states(ids)
    rows = []
    for entry in entries:
        job_id = entry["job_id"]
        state = live.get(job_id)
        if state:
            row = {**entry, **state, "source": "squeue"}
            if row.get("reason") == "None":
                row["reason"] = ""
        else:
            info = job_state(job_id)
            row = {
                **entry,
                "state": info.get("JobState", ""),
                "reason": "" if info.get("Reason") in (None, "", "None") else info["Reason"],
                "nodes": info.get("NodeList", ""),
                "elapsed": info.get("RunTime", ""),
                "exit_code": info.get("ExitCode", ""),
                "source": "scontrol" if info else "gone",
            }
            if not info:
                # No slurmdbd here, so the controller forgets a job once it has
                # finished. Our ledger is the only thing that remembers it.
                row["state"] = "finished"
                row["note"] = "dropped from the controller's memory; the log file is still here"
                rows.append(row)
                continue

        if row["state"] in ("PENDING", "CONFIGURING"):
            waited = human_duration(time.time() - row["submitted_at"])
            row["note"] = f"{explain_pending(row['reason'])}; queued {waited}"
            row["elapsed"] = ""
        elif row["state"] == "CANCELLED":
            # scancel sends SIGTERM, so 143:0 is the expected code, not news
            row["note"] = ""
        elif row.get("exit_code") and row["exit_code"] != "0:0":
            row["note"] = f"exit {row['exit_code']}"
        else:
            row["note"] = ""
        rows.append(row)
    return rows


def tool_slurm_jobs(server: Server, _args: dict[str, Any]) -> tuple[str, bool]:
    now = time.monotonic()
    if server.jobs_cache is not None:
        stamp, cached = server.jobs_cache
        age = now - stamp
        if age < server.config.query_cache_s:
            return f"{cached}\n\n(cached {age:.0f}s ago; refreshed every {server.config.query_cache_s:g}s)", False

    rows = _job_rows(server)
    if not rows:
        return (
            f"no jobs submitted by this server for {server.project.alias}. "
            "Use slurm_submit.",
            False,
        )

    header = f"{'job':>6}  {'state':<10} {'elapsed':<8} {'name':<20} {'where':<24} note"
    lines = [header, "-" * len(header)]
    for row in rows:
        lines.append(
            f"{row['job_id']:>6}  {row['state']:<10} "
            f"{(row.get('elapsed') or ''):<8} {row['name'][:20]:<20} "
            f"{(row.get('nodes') or ''):<24} {row.get('note') or ''}"
        )
    lines.append("")
    lines.append(f"logs: {job_dir(server.project)}/<job_id>.out")
    lines.append(
        "states come from squeue/scontrol only; without a slurmdbd there is no "
        "accounting history, so old finished jobs drop out of the controller's "
        "memory. The ledger above is this server's own record."
    )
    text = "\n".join(lines)
    server.jobs_cache = (now, text)
    return text, False


def tool_slurm_cancel(server: Server, args: dict[str, Any]) -> tuple[str, bool]:
    job_id = _int_arg(args, "job_id", 0)
    if job_id <= 0:
        raise ToolError("job_id must be a positive integer")

    record = server.ledger.has(job_id)
    if record is None:
        # scancel exits 0 even for job ids that do not exist, so the ledger is
        # the only thing standing between the agent and other people's jobs.
        raise ToolError(
            f"job {job_id} was not submitted by this server for "
            f"{server.project.alias!r}; refusing to cancel it"
        )

    before = job_state(job_id)
    finished = ("COMPLETED", "FAILED", "CANCELLED", "TIMEOUT", "OUT_OF_MEMORY", "NODE_FAIL")
    if before.get("JobState") in finished:
        return (
            f"job {job_id} ({record['name']}) had already finished: "
            f"{before.get('JobState')}\nnothing to cancel.\nlog: {record['log']}",
            False,
        )

    proc = slurm("scancel", str(job_id))
    server.jobs_cache = None
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout).decode("utf-8", "replace").strip()
        raise ToolError(f"scancel {job_id} failed (exit {proc.returncode}): {err}")

    # Slurm moves through CANCELLING/COMPLETING before it lets go; a short
    # poll keeps the answer honest without making the agent wait.
    deadline = time.monotonic() + 3.0
    state = ""
    still = True
    while True:
        info = job_state(job_id)
        state = info.get("JobState", "unknown")
        still = job_id in live_states([job_id])
        if state in ("CANCELLED", "COMPLETED", "FAILED", "TIMEOUT") and not still:
            break
        if time.monotonic() >= deadline:
            break
        time.sleep(0.25)

    text = "\n".join(
        [
            f"job_id: {job_id}  ({record['name']})",
            f"state: {state}",
            f"still in the queue: {'yes' if still else 'no'}"
            + ("" if not still else " (Slurm is still tearing it down; check slurm_jobs)"),
            f"log: {record['log']}",
        ]
    )
    return text, False


def tool_slurm_logs(server: Server, args: dict[str, Any]) -> tuple[str, bool]:
    job_id = _int_arg(args, "job_id", 0)
    if job_id <= 0:
        raise ToolError("job_id must be a positive integer")
    lines_wanted = min(max(_int_arg(args, "lines", LOG_TAIL_LINES), 1), MAX_LOG_TAIL_LINES)

    record = server.ledger.has(job_id)
    if record is None:
        # A file may well exist at <log dir>/<id>.out -- Slurm writes there by
        # path, and so could a human. A job this server did not submit is not
        # part of this session, so its output is not served from here.
        raise ToolError(
            f"job {job_id} was not submitted by this server for "
            f"{server.project.alias!r}, so it is not part of this session. Jobs "
            "started outside lumi-mcp are not visible through these tools; "
            "read the file with `shell` if you need it."
        )
    path = Path(record["log"])
    try:
        size = path.stat().st_size
        with path.open("rb") as fh:
            if size > MAX_LOG_BYTES:
                fh.seek(-MAX_LOG_BYTES, os.SEEK_END)
                data = fh.read()
                skipped = size - MAX_LOG_BYTES
            else:
                data = fh.read()
                skipped = 0
    except FileNotFoundError:
        raise ToolError(
            f"no log for job {job_id} at {path}. Slurm creates it when the job "
            "starts; a pending job has no output yet."
        ) from None
    except OSError as exc:
        raise ToolError(f"cannot read {path}: {exc}") from None

    text = data.decode("utf-8", "replace")
    tail = text.splitlines()[-lines_wanted:]
    body = "\n".join(tail)
    prefix = []
    if skipped:
        prefix.append(f"[... {skipped} bytes skipped, showing the last {MAX_LOG_BYTES}]")
    prefix.append(f"log: {path} ({size} bytes)")
    return "\n".join(prefix) + "\n" + body, False


