@dataclass(frozen=True)
class Flags:
    """Runtime capabilities, probed once."""

    no_start: bool
    no_mount_library: bool

    def start_flags(self) -> list[str]:
        flags = list(BASE_START_FLAGS)
        if self.no_mount_library:
            flags.extend(OPTIONAL_START_FLAGS)
        return flags


def image_stamp(image: Path) -> dict[str, Any]:
    """Cheap identity for the image.

    A real sha256 of a multi-GB SIF over Lustre costs minutes at startup;
    mtime+size is instant and still changes when the image is rebuilt.
    """
    try:
        st = image.stat()
    except OSError:
        return {"path": str(image), "missing": True}
    return {"path": str(image), "size": st.st_size, "mtime_ns": st.st_mtime_ns}


class Runtime:
    def __init__(self, command: str) -> None:
        self.command = command
        self._flags: Flags | None = None

    def _help(self, *args: str) -> str:
        try:
            proc = subprocess.run(
                [self.command, *args, "--help"],
                stdin=subprocess.DEVNULL,
                capture_output=True,
                timeout=60,
            )
        except (OSError, subprocess.SubprocessError):
            return ""
        return (proc.stdout + proc.stderr).decode("utf-8", "replace")

    def flags(self) -> Flags:
        if self._flags is None:
            start_help = self._help("instance", "start")
            self._flags = Flags(
                no_start="--no-start" in start_help,
                no_mount_library="--no-mount" in start_help,
            )
            log(
                f"runtime {self.command}: --no-start={self._flags.no_start} "
                f"--no-mount={self._flags.no_mount_library}"
            )
        return self._flags

    def start_flags(self) -> list[str]:
        return self.flags().start_flags()

    def run(self, argv: list[str], timeout: float = 120) -> subprocess.CompletedProcess:
        return subprocess.run(
            argv,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            timeout=timeout,
        )

    def instance_start(self, name: str, project: Project) -> None:
        """Start the instance: apptainer instance start [flags] IMAGE NAME.

        There is no `--name` flag; the image and the instance name are the
        two positional arguments, in that order.
        """
        argv = [self.command, "instance", "start"]
        if self.flags().no_start:
            argv.append("--no-start")
        argv.extend(self.start_flags())
        argv.extend(["-B", f"{project.directory}:{project.directory}"])
        # Bind destination must be absolute, and `~` is not accepted. Using the
        # host $HOME as the destination keeps paths identical inside and out
        # while the contents are the project's throwaway home.
        argv.extend(["-B", f"{project.home}:{host_home()}"])
        argv.extend([str(project.image), name])

        log("starting instance: " + " ".join(shlex.quote(a) for a in argv))
        try:
            proc = self.run(argv, timeout=900)
        except FileNotFoundError:
            raise ToolError(
                f"cannot run {self.command!r}: no such file (check general.command in the config)"
            ) from None
        except (OSError, subprocess.SubprocessError) as exc:
            raise ToolError(f"instance start failed: {exc}") from None
        if proc.returncode != 0:
            err = (proc.stderr or proc.stdout).decode("utf-8", "replace").strip()
            raise ToolError(f"instance start failed (exit {proc.returncode}): {err}")

    def probe_containment(self, name: str, project: Project) -> dict[str, Any]:
        """Assert the containment instead of believing the flags.

        Apptainer silently ignores unknown `--no-mount` values, so a typo in
        the flag list degrades to no containment at all. These checks run once
        after the instance starts and their result is recorded and reported by
        `status`.
        """
        script = "; ".join(
            [
                f"test -d {shlex.quote(str(project.directory))} && echo project=ok || echo project=missing",
                f"test -w {shlex.quote(str(project.directory))} && echo project_rw=yes || echo project_rw=no",
                "test -S /run/munge/munge.socket.2 && echo munge=visible || echo munge=absent",
                "command -v sbatch >/dev/null 2>&1 && echo sbatch=present || echo sbatch=absent",
                f"test -e {shlex.quote(str(host_home()))}/.ssh && echo host_home=visible || echo host_home=hidden",
            ]
        )
        try:
            proc = self.run(
                [self.command, "exec", f"instance://{name}", "/bin/sh", "-c", script],
                timeout=120,
            )
        except (OSError, subprocess.SubprocessError) as exc:
            return {"error": str(exc)}
        out = (proc.stdout or b"").decode("utf-8", "replace")
        findings = dict(
            line.split("=", 1) for line in out.splitlines() if "=" in line
        )
        for key, expected, level in (
            ("project", "ok", "error"),
            ("project_rw", "yes", "error"),
            ("munge", "absent", "warn"),
            ("host_home", "hidden", "warn"),
        ):
            if findings.get(key) != expected:
                log(f"containment {level}: {key}={findings.get(key)!r} (expected {expected!r})")
        if findings.get("sbatch") == "present":
            log("containment note: sbatch is visible inside the container")
        return findings

    def instance_alive(self, name: str) -> bool:
        try:
            proc = self.run([self.command, "exec", f"instance://{name}", "/bin/true"], timeout=60)
        except (OSError, subprocess.SubprocessError):
            return False
        return proc.returncode == 0

    def instance_stop(self, name: str) -> None:
        log(f"stopping instance {name}")
        try:
            self.run([self.command, "instance", "stop", name], timeout=120)
        except (OSError, subprocess.SubprocessError) as exc:
            log(f"instance stop failed: {exc}")

    def exec_script(self, name: str, script: str) -> list[str]:
        return [self.command, "exec", f"instance://{name}", "/bin/sh", "-c", script]


def instance_name(project: Project, runtime: Runtime) -> str:
    """Deterministic name over everything that defines the containment.

    account / partition / env are deliberately excluded: they are policy,
    not containment, so changing them must not create a new container.
    """
    payload = {
        "directory": str(project.directory.resolve()),
        "home": str(project.home.resolve()),
        "image": image_stamp(project.image),
        "runtime": runtime.command,
        "flags": runtime.start_flags(),
    }
    blob = json.dumps(payload, sort_keys=True).encode()
    return "lumi-mcp-" + hashlib.sha256(blob).hexdigest()[:12]


@contextmanager
def locked(path: Path, timeout: float = 120.0):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    deadline = time.monotonic() + timeout
    try:
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    raise ToolError(f"timed out waiting for lock {path}") from None
                time.sleep(0.1)
        yield
    finally:
        os.close(fd)


class Instance:
    """One container per project directory, reused across calls and restarts."""

    def __init__(self, runtime: Runtime, project: Project) -> None:
        self.runtime = runtime
        self.project = project
        self.name = instance_name(project, runtime)
        self.record_path = STATE_DIR / "instances" / f"{self.name}.json"
        self.lock_path = STATE_DIR / "locks" / f"{self.name}.lock"

    # -- record ------------------------------------------------------------

    def read_record(self) -> dict[str, Any] | None:
        try:
            return json.loads(self.record_path.read_text())
        except (OSError, ValueError):
            return None

    def write_record(
        self,
        *,
        created: bool,
        previous: dict[str, Any] | None = None,
        probe: dict[str, Any] | None = None,
    ) -> None:
        now = time.time()
        record = {
            "name": self.name,
            "alias": self.project.alias,
            "directory": str(self.project.directory),
            "image": str(self.project.image),
            "home": str(self.project.home),
            "runtime": self.runtime.command,
            "flags": self.runtime.start_flags(),
            "host": socket.gethostname(),
            "started_at": previous.get("started_at") if previous else now,
            "last_used": now,
            "started_by_us": (previous or {}).get("started_by_us", True) if previous else True,
            "probe": probe,
        }
        if created:
            record["started_at"] = now
        self.record_path.parent.mkdir(parents=True, exist_ok=True)
        tmp = self.record_path.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(record, indent=2) + "\n")
        os.chmod(tmp, 0o600)
        tmp.replace(self.record_path)

    def touch(self) -> None:
        record = self.read_record()
        if record:
            record["last_used"] = time.time()
            try:
                self.record_path.write_text(json.dumps(record, indent=2) + "\n")
            except OSError:
                pass

    # -- lifecycle ---------------------------------------------------------

    def ensure(self) -> tuple[dict[str, Any], bool]:
        """Return (record, created). Starts the instance if it is not alive."""
        with locked(self.lock_path):
            existing = self.read_record()
            if existing:
                if self.runtime.instance_alive(self.name):
                    self.touch()
                    return self.read_record() or existing, False
                log(f"instance {self.name} has a record but is not alive; recycling")
                self.runtime.instance_stop(self.name)
                try:
                    self.record_path.unlink()
                except OSError:
                    pass

            for path, kind in ((self.project.image, "image"), (self.project.directory, "directory")):
                if not path.exists():
                    raise ToolError(f"project {self.project.alias}: {kind} does not exist: {path}")
            if self.project.home.exists():
                if not self.project.home.is_dir():
                    raise ToolError(f"project {self.project.alias}: home is not a directory: {self.project.home}")
            else:
                self.project.home.mkdir(parents=True, exist_ok=True)
            os.chmod(self.project.home, 0o700)

            self.runtime.instance_start(self.name, self.project)
            probe = self.runtime.probe_containment(self.name, self.project)
            if probe.get("project") != "ok" or probe.get("project_rw") != "yes":
                # The project must be visible and writable or nothing else
                # matters; do not hand out an instance that cannot do its job.
                self.runtime.instance_stop(self.name)
                raise ToolError(
                    f"containment probe failed for project {self.project.alias}: {probe}"
                )
            self.write_record(created=True, probe=probe)
            return self.read_record() or {}, True

    def stop(self) -> None:
        self.runtime.instance_stop(self.name)
        try:
            self.record_path.unlink()
        except OSError:
            pass

    def is_alive(self) -> bool:
        return self.runtime.instance_alive(self.name)


# --------------------------------------------------------------------------
# command execution
# --------------------------------------------------------------------------


def resolve_cwd(project: Project, cwd: str | None) -> Path:
    root = project.directory.resolve()
    if not cwd:
        return root
    target = Path(cwd)
    if not target.is_absolute():
        target = root / target
    try:
        resolved = target.resolve()
    except OSError as exc:
        raise ToolError(f"cannot resolve cwd: {exc}") from None
    if not path_is_under(resolved, root):
        raise ToolError(f"cwd {resolved} is outside the project directory {root}")
    return resolved


def truncate(data: bytes, limit: int = MAX_OUTPUT_BYTES) -> str:
    text = data[:limit].decode("utf-8", "replace")
    dropped = len(data) - limit
    if dropped > 0:
        text += f"\n[... {dropped} bytes truncated]"
    return text


def kill_group(pid: int) -> None:
    for sig, grace in ((signal.SIGTERM, 5.0), (signal.SIGKILL, 5.0)):
        try:
            os.killpg(pid, sig)
        except OSError:
            return
        deadline = time.monotonic() + grace
        while time.monotonic() < deadline:
            try:
                os.killpg(pid, 0)
            except OSError:
                return
            time.sleep(0.05)


def build_script(project: Project, cwd: Path, command: str) -> str:
    lines = [f"cd {shlex.quote(str(cwd))}"]
    for key, value in project.env.items():
        lines.append(f"export {key}={shlex.quote(value)}")
    lines.append(command)
    return "\n".join(lines)


def run_in_instance(
    runtime: Runtime, name: str, script: str, timeout_s: float
) -> tuple[int, bytes, bytes, bool, float]:
    """Run a script by joining the instance.

    NOTE: on timeout we kill the host-side client's process group. That does
    not reliably kill processes started inside the container -- real
    cancellation needs the container-side process group (future work).
    """
    argv = runtime.exec_script(name, script)
    started = time.monotonic()
    proc = subprocess.Popen(
        argv,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=True,
    )
    timed_out = False
    try:
        out, err = proc.communicate(timeout=timeout_s)
    except subprocess.TimeoutExpired:
        timed_out = True
        kill_group(proc.pid)
        try:
            out, err = proc.communicate(timeout=30)
        except subprocess.TimeoutExpired:
            proc.kill()
            out, err = proc.communicate()
    return proc.returncode or 0, out or b"", err or b"", timed_out, time.monotonic() - started


