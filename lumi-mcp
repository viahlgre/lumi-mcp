# server state and tools
# --------------------------------------------------------------------------


@dataclass
class Server:
    config: Config
    project: Project
    runtime: Runtime
    instance: Instance


def tool_shell(server: Server, args: dict[str, Any]) -> tuple[str, bool]:
    command = args.get("command")
    if not isinstance(command, str) or not command.strip():
        raise ToolError("command must be a non-empty string")

    cwd = resolve_cwd(server.project, args.get("cwd"))

    raw_timeout = args.get("timeout_s", DEFAULT_TIMEOUT_S)
    try:
        timeout_s = float(raw_timeout)
    except (TypeError, ValueError):
        raise ToolError("timeout_s must be a number") from None
    timeout_s = max(1.0, min(timeout_s, MAX_TIMEOUT_S))

    record, created = server.instance.ensure()
    script = build_script(server.project, cwd, command)
    rc, out, err, timed_out, duration = run_in_instance(
        server.runtime, server.instance.name, script, timeout_s
    )
    server.instance.touch()

    chunks = [f"exit_code: {rc}", f"duration_ms: {int(duration * 1000)}"]
    if created:
        chunks.append(f"instance: started {server.instance.name}")
    if timed_out:
        chunks.append(f"timed_out: true (after {timeout_s:g}s)")
    if out:
        chunks.append("--- stdout ---\n" + truncate(out).rstrip("\n"))
    if err:
        chunks.append("--- stderr ---\n" + truncate(err).rstrip("\n"))
    text = "\n".join(chunks)

    if timed_out:
        return text + (
            "\n\nNOTE: the timeout killed the host-side apptainer client. "
            "Processes started inside the container may still be running."
        ), True
    return text, rc != 0


def tool_status(server: Server, _args: dict[str, Any]) -> tuple[str, bool]:
    record = server.instance.read_record()
    alive = server.instance.is_alive()
    info = {
        "server": {"name": SERVER_NAME, "version": SERVER_VERSION},
        "host": socket.gethostname(),
        "uid": os.getuid(),
        "config": str(server.config.path),
        "state_dir": str(STATE_DIR),
        "runtime": {
            "command": server.runtime.command,
            "start_flags": server.runtime.start_flags(),
        },
        "project": {
            "alias": server.project.alias,
            "description": server.project.description,
            "directory": str(server.project.directory),
            "home": str(server.project.home),
            "image": str(server.project.image),
            "account": server.project.account,
            "partition": server.project.partition,
            "env": server.project.env,
        },
        "instance": {
            "name": server.instance.name,
            "alive": alive,
            "record": record,
        },
        "limits": {
            "default_timeout_s": DEFAULT_TIMEOUT_S,
            "max_timeout_s": MAX_TIMEOUT_S,
            "max_output_bytes": MAX_OUTPUT_BYTES,
        },
    }
    return json.dumps(info, indent=2), False


