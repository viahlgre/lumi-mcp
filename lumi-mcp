def handle_tools_call(server: Server, params: dict[str, Any]) -> dict[str, Any]:
    name = params.get("name")
    args = params.get("arguments") or {}
    if not isinstance(args, dict):
        return _text_result("arguments must be an object", is_error=True)

    handlers = {"shell": tool_shell, "status": tool_status}
    handler = handlers.get(name)
    if handler is None:
        return _text_result(f"unknown tool: {name!r}", is_error=True)

    try:
        text, is_error = handler(server, args)
    except ToolError as exc:
        return _text_result(str(exc), is_error=True)
    except Exception as exc:  # noqa: BLE001 - surface, don't crash the server
        log("tool crashed:\n" + traceback.format_exc())
        return _text_result(f"internal error: {exc}", is_error=True)
    return _text_result(text, is_error=is_error)


def _text_result(text: str, *, is_error: bool = False) -> dict[str, Any]:
    result: dict[str, Any] = {"content": [{"type": "text", "text": text}]}
    if is_error:
        result["isError"] = True
    return result


# --------------------------------------------------------------------------
# JSON-RPC over stdio
# --------------------------------------------------------------------------


def send(message: dict[str, Any]) -> None:
    sys.stdout.write(json.dumps(message) + "\n")
    sys.stdout.flush()


def error_response(msg_id: Any, code: int, message: str) -> dict[str, Any]:
    return {"jsonrpc": "2.0", "id": msg_id, "error": {"code": code, "message": message}}


def handle(server: Server, msg: dict[str, Any]) -> dict[str, Any] | None:
    method = msg.get("method")
    msg_id = msg.get("id")
    params = msg.get("params") or {}

    # notifications carry no id and get no response
    if msg_id is None:
        return None

    if method == "initialize":
        requested = params.get("protocolVersion")
        version = requested if requested in PROTOCOL_KNOWN else PROTOCOL_FALLBACK
        return {
            "jsonrpc": "2.0",
            "id": msg_id,
            "result": {
                "protocolVersion": version,
                "capabilities": {"tools": {"listChanged": False}},
                "serverInfo": {"name": SERVER_NAME, "version": SERVER_VERSION},
                "instructions": INSTRUCTIONS.format(
                    alias=server.project.alias,
                    directory=server.project.directory,
                    host=socket.gethostname(),
                ),
            },
        }
    if method == "ping":
        return {"jsonrpc": "2.0", "id": msg_id, "result": {}}
    if method == "tools/list":
        return {"jsonrpc": "2.0", "id": msg_id, "result": {"tools": TOOLS}}
    if method == "tools/call":
        if not isinstance(params, dict):
            return error_response(msg_id, -32602, "params must be an object")
        return {"jsonrpc": "2.0", "id": msg_id, "result": handle_tools_call(server, params)}
    if method in ("resources/list", "prompts/list"):
        return {"jsonrpc": "2.0", "id": msg_id, "result": {}}

    return error_response(msg_id, -32601, f"method not found: {method}")


def serve(server: Server) -> int:
    log(f"serving project {server.project.alias!r} on {socket.gethostname()} (pid {os.getpid()})")
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError as exc:
            send(error_response(None, -32700, f"parse error: {exc}"))
            continue
        if not isinstance(msg, dict):
            send(error_response(None, -32600, "invalid request"))
            continue
        try:
            response = handle(server, msg)
        except Exception as exc:  # noqa: BLE001
            log("request crashed:\n" + traceback.format_exc())
            response = error_response(msg.get("id"), -32603, f"internal error: {exc}")
        if response is not None:
            send(response)
    log("stdin closed; exiting")
    return 0


# --------------------------------------------------------------------------
# entry point
# --------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="lumi-mcp",
        description="stdio MCP server for a LUMI project directory inside Apptainer.",
    )
    parser.add_argument(
        "--config",
        default=os.environ.get("LUMI_MCP_CONFIG", str(DEFAULT_CONFIG)),
        help=f"config file (default: {DEFAULT_CONFIG})",
    )
    parser.add_argument(
        "--project",
        default=None,
        help="project alias from the config; defaults to the project containing $PWD",
    )
    parser.add_argument("--status", action="store_true", help="print resolved status and exit")
    parser.add_argument("--stop", action="store_true", help="stop this project's instance and exit")
    parser.add_argument("--version", action="version", version=f"{SERVER_NAME} {SERVER_VERSION}")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)

    try:
        config = load_config(Path(args.config).expanduser())
        project = select_project(config, args.project, Path.cwd())
    except ConfigError as exc:
        log(f"error: {exc}")
        return 2

    runtime_ok = os.path.isfile(config.command) and os.access(config.command, os.X_OK)
    if not runtime_ok:
        # --status is still useful for debugging a broken config, so only the
        # serving path is fatal here.
        msg = f"general.command is not an executable file: {config.command}"
        if not args.status:
            log(f"error: {msg}")
            return 2
        log(f"warning: {msg}")

    runtime = Runtime(config.command)
    server = Server(
        config=config,
        project=project,
        runtime=runtime,
        instance=Instance(runtime, project),
    )

    if args.status:
        print(tool_status(server, {})[0])
        return 0
    if args.stop:
        server.instance.stop()
        print(f"stopped {server.instance.name}")
        return 0

    try:
        return serve(server)
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
